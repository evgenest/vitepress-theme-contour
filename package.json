  "description": "A VitePress 2 theme with a calmer layout, framed code blocks, a global line-wrap toggle and an auto/light/dark switch.",
  "keywords": [
    "vitepress",
    "vitepress-theme",
    "documentation",
    "theme"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evgenest/vitepress-theme-contour.git"
  },
  "homepage": "https://github.com/evgenest/vitepress-theme-contour#readme",
  "bugs": {
    "url": "https://github.com/evgenest/vitepress-theme-contour/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./theme/index.d.ts",
      "default": "./theme/index.ts"
    },
    "./config": {
      "types": "./config.d.ts",
      "default": "./config.js"
    }
  },
  "files": [
    "theme",
    "config.js",
    "config.d.ts"
